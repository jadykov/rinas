---
import '../styles/global.css';
import Metrics from '../components/Metrics.astro';
import SocialBadge from '../components/SocialBadge.astro';
import { TELEGRAM_LINK, MAX_LINK, SITE_URL } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const fullTitle = title ? `${title} — Мастерская кашпо` : 'Мастерская кашпо';
const canonical = `${SITE_URL || Astro.url.origin}${Astro.url.pathname}`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Мастерская кашпо" />
    <meta property="og:type" content={image ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <Metrics />
  </head>
  <body>
    <header class="header">
      <div class="container header__inner">
        <a class="logo" href="/">
          <svg class="logo__mark" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="24" height="24" rx="6" fill="var(--accent)" />
            <path d="M12 13c0-4-2.5-6-2.5-6s0 4 2.5 6z" fill="#f0e7d8" />
            <path d="M12 13c0-4.5 3-7 3-7s0 4.5-3 7z" fill="#f6f0e6" />
            <path
              d="M8.5 13.5h7l-.7 4.5a1 1 0 0 1-1 .8h-3.6a1 1 0 0 1-1-.8l-.7-4.5z"
              fill="#f0e7d8"
            />
          </svg>
          Кашпо<span class="logo__accent"> из массива</span>
        </a>
        <nav class="nav" aria-label="Основная навигация">
          <a class="nav__home" href="/">
            <svg class="nav__home-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="24" height="24" rx="6" fill="var(--accent)" />
              <path d="M12 13c0-4-2.5-6-2.5-6s0 4 2.5 6z" fill="#f0e7d8" />
              <path d="M12 13c0-4.5 3-7 3-7s0 4.5-3 7z" fill="#f6f0e6" />
              <path
                d="M8.5 13.5h7l-.7 4.5a1 1 0 0 1-1 .8h-3.6a1 1 0 0 1-1-.8l-.7-4.5z"
                fill="#f0e7d8"
              />
            </svg>
            Главная
          </a>
          <a href="/catalog">Каталог</a>
          <a href="/info">Доставка</a>
          <a href="/about">О нас</a>
          <a class="nav__cta" href="/custom">На заказ</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <p>© {new Date().getFullYear()} Мастерская кашпо. Кашпо из массива дерева на заказ.</p>
        <nav class="footer__links" aria-label="Служебные страницы">
          <a href="/info">Доставка и оплата</a>
          <a href="/privacy">Политика конфиденциальности</a>
        </nav>
        {(TELEGRAM_LINK || MAX_LINK) && (
          <div class="footer__social" aria-label="Мы в мессенджерах">
            {TELEGRAM_LINK && (
              <SocialBadge href={TELEGRAM_LINK} icon="telegram" label="Написать в Telegram" metric="telegram_click" />
            )}
            {MAX_LINK && (
              <SocialBadge href={MAX_LINK} icon="max" label="Написать в MAX" metric="max_click" />
            )}
          </div>
        )}
      </div>
    </footer>
  </body>
</html>

<style>
  .header {
    /* Не отдельная цветная плашка — тот же фон, что у страницы,
       граница только тонкой линией. Так шапка не «спорит» с hero,
       который теперь тоже почти не выделен тоном. */
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    display: flex;
    /* На узких экранах меню переносится под логотип целой строкой */
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem 1rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text);
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo__accent {
    color: var(--accent);
  }

  .logo__mark {
    width: 0.92em;
    height: 0.92em;
    flex-shrink: 0;
  }

  /* На узких экранах вместо отдельной строки с названием сайта — единая
     строка меню: «Главная» (со значком сайта вместо точки) в том же ряду
     и в том же стиле, что остальные пункты. */
  @media (max-width: 767px) {
    .logo {
      display: none;
    }
  }

  .nav a.nav__home {
    display: none;
  }

  @media (max-width: 767px) {
    .nav a.nav__home {
      display: inline-flex;
    }
  }

  .nav__home-icon {
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .logo {
      font-size: 1.375rem;
    }
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem 0.875rem;
    font-size: 0.875rem;
    margin-left: auto;
  }

  @media (min-width: 768px) {
    .nav {
      font-size: 0.8125rem;
    }
  }

  /* На узких экранах логотип упразднён (см. .nav__home) — вся навигация
     в одну строку, поэтому спейсинг плотнее, чтобы все пункты уместились
     без переноса. */
  @media (max-width: 767px) {
    .nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.2rem 0.25rem;
      font-size: 0.6875rem;
      margin-left: 0;
    }

    .nav a {
      gap: 0.2rem;
    }

    .nav__home-icon {
      width: 0.7rem;
      height: 0.7rem;
    }
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text);
    font-weight: 500;
    /* Пункт меню не разрывается внутри себя на два слова */
    white-space: nowrap;
  }

  /* Компактная чёрточка слева от каждого пункта меню — простой
     графический якорь для плоского текста без цветной панели.
     У «На заказ» свой акцент (тонированный фон), чёрточка не нужна. */
  .nav a:not(.nav__cta):not(.nav__home)::before {
    content: '';
    width: 3px;
    height: 3px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .nav a:hover {
    color: var(--accent-strong);
    text-decoration: none;
  }

  /* «На заказ» — та же текстовая ссылка, что и остальные пункты, просто
     акцентным цветом и чуть жирнее, без заливки-пилюли (раньше слишком
     выделялась на фоне остального меню). */
  /* Мягкий тонированный фон вместо сплошной пилюли — даёт форму и вес,
     но остаётся тихим, без чёткой границы. */
  .nav a.nav__cta {
    padding: 0.25rem 0.55rem;
    border-radius: 8px;
    background: rgba(154, 107, 63, 0.12);
    color: var(--accent-strong);
    font-weight: 700;
    /* Зафиксирован отдельно от .nav — при уменьшении шрифта остальных
       пунктов меню на десктопе «На заказ» не должна мельчать вместе с ними. */
    font-size: 0.875rem;
  }

  /* На мобильных, наоборот, «На заказ» тоже уплотняется — иначе не
     умещается в общую строку меню вместе с остальными пунктами. */
  @media (max-width: 767px) {
    .nav a.nav__cta {
      font-size: 0.6875rem;
      padding: 0.15rem 0.3rem;
    }
  }

  .nav a.nav__cta::before {
    content: '';
    width: 3px;
    height: 3px;
    background: var(--accent-strong);
    flex-shrink: 0;
  }

  .nav a.nav__cta:hover {
    background: rgba(154, 107, 63, 0.2);
  }

  .footer {
    margin-top: 4rem;
    padding: 2rem 0;
    background: var(--bg-elevated);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer p {
    margin: 0;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer__links a {
    color: var(--text-muted);
  }

  .footer__social {
    display: flex;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .footer__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .footer__links {
      flex-direction: row;
      gap: 1.25rem;
    }
  }
</style>