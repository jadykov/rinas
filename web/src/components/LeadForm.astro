---
/**
 * Форма заявки. Используется на главной, на /custom и в карточке товара.
 * Отправляет данные на /api/lead (SSR-эндпоинт): запись в leads + уведомление в Telegram.
 */
interface Props {
  /** Текст заголовка над формой. Если пусто — заголовок не выводится. */
  title?: string;
  /** id товара (relation в leads). Необязательно. */
  productId?: string;
  /** Название товара для подписи в форме. */
  productName?: string;
  /** Метка источника заявки (страница). */
  source: string;
  /** Текст кнопки отправки. */
  submitText?: string;
}

const { title, productId, productName, source, submitText = 'Отправить заявку' } =
  Astro.props;
const formId = `lead-form-${Math.random().toString(36).slice(2, 8)}`;
---

{
  title && <h2 class="lead-form__title">{title}</h2>
}

<form id={formId} class="lead-form" method="post" action="/api/lead" enctype="multipart/form-data" data-lead-form>
  {productId && <input type="hidden" name="product" value={productId} />}
  {source && <input type="hidden" name="source" value={source} />}

  <div class="lead-form__row">
    <label class="lead-form__label">
      <span class="lead-form__label-text">Ваше имя *</span>
      <input class="lead-form__input" type="text" name="name" required maxlength="120" autocomplete="name" placeholder="Как к вам обращаться" />
    </label>

    <label class="lead-form__label">
      <span class="lead-form__label-text">Контакт для связи *</span>
      <input class="lead-form__input" type="text" name="contact" required maxlength="120" autocomplete="tel" placeholder="Телефон или @username" />
    </label>
  </div>

  {productName && <p class="lead-form__product">Интересует: {productName}</p>}

  <label class="lead-form__label">
    <span class="lead-form__label-text">Опишите заказ</span>
    <textarea class="lead-form__input lead-form__input--area" name="message" rows="4" maxlength="2000" placeholder="Размеры горшка, интерьер, материал, сроки…"></textarea>
  </label>

  <label class="lead-form__label">
    <span class="lead-form__label-text">Фото интерьера или референсы (до 5 файлов, до 20 МБ)</span>
    <input class="lead-form__file" type="file" name="attachments" multiple accept="image/jpeg,image/png,image/webp,application/pdf" />
  </label>

  <label class="lead-form__checkbox">
    <input type="checkbox" name="consent" required />
    <span>Согласен на обработку персональных данных в соответствии с <a href="/privacy">политикой конфиденциальности</a> *</span>
  </label>

  <input class="lead-form__honeypot" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <button class="lead-form__submit" type="submit">{submitText}</button>

  <p class="lead-form__status" data-lead-status role="status"></p>
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('[data-lead-form]');

  for (const form of forms) {
    const status = form.querySelector<HTMLElement>('[data-lead-status]');
    if (!status) continue;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      status.classList.remove('lead-form__status--error');

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) {
        button.disabled = true;
        button.textContent = 'Отправляем…';
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          status.textContent = 'Заявка отправлена, свяжемся в течение дня. Спасибо!';
          form.reset();
        } else {
          status.textContent = data.error || 'Не удалось отправить. Попробуйте ещё раз.';
          status.classList.add('lead-form__status--error');
        }
      } catch {
        status.textContent = 'Не удалось отправить. Проверьте интернет и попробуйте ещё раз.';
        status.classList.add('lead-form__status--error');
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = '{submitText}';
        }
      }
    });
  }
</script>

<style>
  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .lead-form__title {
    margin: 0 0 1.25rem;
  }

  .lead-form__label {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .lead-form__label-text {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
  }

  .lead-form__input {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    width: 100%;
  }

  .lead-form__input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: transparent;
  }

  .lead-form__input--area {
    resize: vertical;
    min-height: 6rem;
  }

  .lead-form__file {
    font: inherit;
    color: var(--text-muted);
  }

  .lead-form__product {
    margin: 0;
    color: var(--accent-strong);
    font-weight: 600;
  }

  .lead-form__checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
    cursor: pointer;
  }

  .lead-form__checkbox input {
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .lead-form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .lead-form__submit {
    align-self: flex-start;
    padding: 0.875rem 1.75rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .lead-form__submit:hover {
    background: var(--accent-strong);
  }

  .lead-form__submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .lead-form__status {
    margin: 0;
    font-weight: 600;
    color: var(--accent-strong);
  }

  .lead-form__status--error {
    color: #b3261e;
  }

  @media (min-width: 640px) {
    .lead-form__row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
  }
</style>