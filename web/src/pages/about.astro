---
import { getPageBySlug, fileUrl } from '../lib/pb';
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';

const workshopPage = await getPageBySlug('workshop');
const workshopPhotos = (workshopPage?.photos ?? []).map((f) =>
  fileUrl('pages', workshopPage!.id, f, Astro.url.origin),
);
---
<Base title="О нас" description="Мастерская кашпо из массива дерева. Работаем вдвоём, вручную, делаем на заказ любой сложности.">
  <section class="page container">
    <div class="about">
      <div>
        <h1 class="page__title">О мастерской</h1>
        <p>
          Мы делаем кашпо из массива дерева — вдвоём, вручную, в небольшой
          мастерской. Не конвейер и не серийное производство: каждая работа
          собирается под конкретный горшок и интерьер.
        </p>
        <p>
          Берёмся за заказы любой сложности: от аккуратного настольного кашпо до
          нестандартных форм по вашим чертежам или фотографиям. Любим дерево,
          работаем с дубом, ясенем, орехом и сосной, подбираем породу и обработку
          под ваш интерьер.
        </p>
        <p>
          Показываем готовое изделие до отправки. Если что-то не устроит —
          доработаем.
        </p>
      </div>

      <LeadForm
        title="Задайте вопрос или оставьте заявку"
        source="about"
        submitText="Отправить"
      />
    </div>

    {workshopPhotos.length > 0 && (
      <div class="about__gallery">
        <h2 class="about__gallery-title">Мастерская</h2>
        <ul class="about__gallery-grid">
          {workshopPhotos.map((src) => (
            <li>
              <button class="about__gallery-btn" type="button" data-lightbox-open>
                <img class="about__gallery-img" src={src} alt="Мастерская" loading="lazy" />
              </button>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <div class="lightbox" data-lightbox hidden>
    <button class="lightbox__close" type="button" data-lightbox-close aria-label="Закрыть">×</button>
    <img class="lightbox__img" data-lightbox-img src="" alt="Мастерская" />
  </div>
</Base>

<script>
  const lightbox = document.querySelector<HTMLDivElement>('[data-lightbox]');
  const lightboxImg = document.querySelector<HTMLImageElement>('[data-lightbox-img]');

  function openLightbox(src: string) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = src;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImg) return;
    lightbox.hidden = true;
    lightboxImg.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const img = btn.querySelector('img');
      if (img) openLightbox(img.src);
    });
  });

  document.querySelector('[data-lightbox-close]')?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

<style>
  .page {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .page__title {
    margin: 0 0 1rem;
  }

  .about {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .about p {
    color: var(--text-muted);
    margin: 0 0 1rem;
    max-width: 38em;
  }

  .about__gallery {
    margin-top: 2.5rem;
  }

  .about__gallery-title {
    margin: 0 0 1rem;
  }

  .about__gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .about__gallery-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: var(--radius);
  }

  .about__gallery-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .about__gallery-btn:hover .about__gallery-img {
    transform: scale(1.02);
    opacity: 0.92;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(20, 17, 14, 0.92);
    padding: 1rem;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius);
  }

  .lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  @media (min-width: 640px) {
    .about__gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 1fr 1fr;
    }

    .about__gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>