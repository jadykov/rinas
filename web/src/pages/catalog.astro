---
import { getProducts, fileUrl } from '../lib/pb';
import Base from '../layouts/Base.astro';

const products = await getProducts();

const description = 'Кашпо из массива дерева: напольные, настольные, подвесные. Любой размер и сложность — на заказ.';
---
<Base title="Каталог" description={description}>
  <section class="page container">
    <h1 class="page__title">Каталог кашпо</h1>
    <p class="page__lead">
      Изделия из массива дерева. Каждое делаем вручную, любой размер и сложность —
      закажите под свой горшок.
    </p>

    <ul class="grid">
      {
        products.map((p) => {
          const mainPhoto = p.photos?.[0]
            ? fileUrl('products', p.id, p.photos[0])
            : null;
          return (
            <li class="card">
              <a class="card__link" href={`/catalog/${p.slug}`}>
                {mainPhoto ? (
                  <img class="card__img" src={mainPhoto} alt={p.title} loading="lazy" />
                ) : (
                  <div class="card__img card__img--placeholder">Фото скоро</div>
                )}
                <div class="card__body">
                  <h2 class="card__title">{p.title}</h2>
                  {p.price_from && <p class="card__price">от {p.price_from} ₽</p>}
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>

<style>
  .page {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }

  .page__title {
    margin: 0 0 0.5rem;
  }

  .page__lead {
    margin: 0 0 2rem;
    color: var(--text-muted);
    font-size: var(--text-lg);
    max-width: 38em;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.15s ease;
  }

  .card__link {
    display: block;
    color: inherit;
  }

  .card__link:hover {
    text-decoration: none;
  }

  .card__link:hover .card {
    transform: translateY(-3px);
  }

  .card__img {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
  }

  .card__img--placeholder {
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .card__body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .card__title {
    margin: 0 0 0.25rem;
    font-size: var(--text-lg);
  }

  .card__price {
    margin: 0;
    color: var(--accent-strong);
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>