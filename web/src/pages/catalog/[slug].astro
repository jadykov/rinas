---
import { getProductBySlug, fileUrl } from '../../lib/pb';
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';

const { slug } = Astro.params;

let product = null;
if (slug) {
  product = await getProductBySlug(slug);
}

if (!product) {
  return Astro.rewrite('/404');
}

const typeLabel = product.type ?? '';
const materialLabel = product.material ?? '';
const diameterInfo =
  product.pot_diameter_min && product.pot_diameter_max
    ? `${product.pot_diameter_min}–${product.pot_diameter_max} см`
    : product.pot_diameter_min
      ? `от ${product.pot_diameter_min} см`
      : product.pot_diameter_max
        ? `до ${product.pot_diameter_max} см`
        : null;
const dimensions =
  product.height && product.width ? `${product.height} × ${product.width} см` : null;

const seoTitle = product.seo_title || `${product.title} из массива дерева`;
const seoDescription = product.seo_description || product.description || '';
const photos = (product.photos ?? []).map((f) => fileUrl('products', product.id, f, Astro.url.origin));
const mainPhoto = photos[0] ?? null;

const modelUrl = product.model_3d
  ? fileUrl('products', product.id, product.model_3d, Astro.url.origin)
  : '';

const h1Title = diameterInfo && !product.title.includes('горшк')
  ? `${product.title} под горшок ${diameterInfo}`
  : product.title;

const productJsonLd = JSON.stringify({
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.title,
  description: seoDescription,
  image: mainPhoto ?? undefined,
  offers: {
    '@type': 'Offer',
    price: product.price_from ?? undefined,
    priceCurrency: 'RUB',
    availability: product.in_stock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/MadeToOrder',
  },
});
---
<Base title={seoTitle} description={seoDescription} image={mainPhoto}>
  <script type="application/ld+json" set:html={productJsonLd} />
  <article class="page container">
    <a class="back" href="/catalog">← В каталог</a>

    <div class="card">
      <div class="card__media">
        {mainPhoto ? (
          <img class="card__img" src={mainPhoto} alt={product.title} />
        ) : (
          <div class="card__img card__img--placeholder">
            <PhotoPlaceholder />
            <span>Фото скоро добавят</span>
          </div>
        )}
      </div>

      <div class="card__content">
        <h1 class="card__title">{h1Title}</h1>

        {product.price_from && (
          <p class="card__price">от {product.price_from} ₽</p>
        )}

        <p class="card__desc">{seoDescription}</p>

        {product.description && <p class="card__text">{product.description}</p>}

        <h2 class="card__h2">Характеристики</h2>
        <dl class="specs">
          {typeLabel && (
            <>
              <dt>Тип</dt>
              <dd>{typeLabel}</dd>
            </>
          )}
          {materialLabel && (
            <>
              <dt>Материал</dt>
              <dd>{materialLabel}</dd>
            </>
          )}
          {diameterInfo && (
            <>
              <dt>Диаметр горшка</dt>
              <dd>{diameterInfo}</dd>
            </>
          )}
          {dimensions && (
            <>
              <dt>Размер</dt>
              <dd>{dimensions}</dd>
            </>
          )}
          {product.in_stock !== null && (
            <>
              <dt>Наличие</dt>
              <dd>{product.in_stock ? 'в наличии' : 'под заказ'}</dd>
            </>
          )}
          {product.lead_time_days && (
            <>
              <dt>Срок изготовления</dt>
              <dd>{product.lead_time_days} дней</dd>
            </>
          )}
        </dl>

        <a class="btn" href="/custom">Заказать похожее</a>
      </div>
    </div>

    {modelUrl && (
      <div class="viewer" data-viewer>
        <div class="viewer__preview" data-viewer-preview>
          <p class="viewer__hint">Осмотрите изделие со всех сторон</p>
          {mainPhoto ? (
            <img class="viewer__thumb" src={mainPhoto} alt={product.title} />
          ) : (
            <div class="viewer__thumb viewer__thumb--placeholder">
              <PhotoPlaceholder />
              <span>Фото скоро</span>
            </div>
          )}
          <button class="viewer__cta" type="button" data-viewer-open>
            Смотреть в 3D
          </button>
        </div>
        <model-viewer
          class="viewer__canvas"
          data-src={modelUrl}
          alt={product.title}
          camera-controls
          auto-rotate
          shadow-intensity="1"
          exposure="1.1"
        ></model-viewer>
      </div>
    )}

    <div class="card-lead">
      <LeadForm
        title="Хотите такое же — оставьте заявку"
        productId={product.id}
        productName={product.title}
        source={`product:${product.slug}`}
        submitText="Заказать"
      />
    </div>
  </article>
</Base>

<script>
  // Загружаем модель только по клику на «Смотреть в 3D» — не при открытии страницы.
  const viewer = document.querySelector('[data-viewer]');
  const openBtn = viewer?.querySelector('[data-viewer-open]');
  const preview = viewer?.querySelector('[data-viewer-preview]');
  const canvas = viewer?.querySelector('model-viewer');

  if (openBtn && canvas) {
    openBtn.addEventListener('click', async () => {
      openBtn.disabled = true;
      openBtn.textContent = 'Загружаем…';
      try {
        await import('@google/model-viewer');
        canvas.setAttribute('src', canvas.dataset.src || '');
        preview?.classList.add('viewer__preview--hidden');
      } catch {
        openBtn.textContent = 'Не удалось загрузить 3D';
      }
    });
  }
</script>

<style>
  .page {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.25rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .card__img {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
  }

  .card__img--placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--bg);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .card__content {
    padding: 1.5rem var(--gutter);
  }

  .card__title {
    margin: 0 0 0.5rem;
    font-size: var(--text-2xl);
  }

  .card__price {
    margin: 0 0 1rem;
    font-size: var(--text-xl);
    color: var(--accent-strong);
    font-weight: 700;
  }

  .card__desc {
    color: var(--text-muted);
    font-style: italic;
    margin: 0 0 1rem;
  }

  .card__text {
    margin: 0 0 1.5rem;
  }

  .card__h2 {
    margin: 0 0 0.75rem;
    font-size: var(--text-lg);
  }

  .specs {
    margin: 0 0 1.5rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .specs dt {
    color: var(--text-muted);
  }

  .specs dd {
    margin: 0;
    text-align: right;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 1.5rem;
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    font-weight: 600;
    text-align: center;
  }

  .btn:hover {
    background: var(--accent-strong);
    text-decoration: none;
  }

  .card-lead {
    margin-top: 2rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.5rem var(--gutter);
  }

  .viewer {
    margin-top: 2rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .viewer__preview {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    background: var(--bg);
    text-align: center;
    padding: 1.5rem;
  }

  .viewer__preview--hidden {
    display: none;
  }

  .viewer__hint {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .viewer__thumb {
    max-height: 240px;
    object-fit: contain;
    border-radius: 8px;
  }

  .viewer__thumb--placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    max-height: 180px;
    background: var(--bg-elevated);
    color: var(--text-muted);
  }

  .viewer__cta {
    padding: 0.875rem 1.75rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .viewer__cta:hover {
    background: var(--accent-strong);
  }

  .viewer__cta:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .viewer__canvas {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  @media (min-width: 768px) {
    .card-lead {
      padding: 2rem;
    }

    .card {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .card__media {
      background: var(--bg);
    }

    .card__img {
      height: 100%;
    }

    .card__content {
      padding: 2rem;
    }
  }
</style>